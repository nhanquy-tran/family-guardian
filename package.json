{
  "name": "family-guardian",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:ext": "npm run dev -w extension",
    "build": "npm run build -w @fg/shared --if-present && npm run build -w web && npm run build -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:ci": "npm run typecheck && npm run lint && npm run coverage",
    "e2e": "npm run e2e -w @fg/e2e",
    "e2e:seed": "npm run seed -w @fg/e2e --",
    "e2e:reset": "npm run reset -w @fg/e2e"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fission-ai/openspec": "2.1.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^5",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
